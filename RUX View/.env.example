# Vision OS — Environment Variables
# Copy this to .env and fill in your actual values

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/visionos
# Format for Cloud SQL: postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── AI APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Get Groq API key from: https://console.groq.com/keys
# Groq replaces OpenAI Whisper for faster Bangla transcription

# ── Firebase Auth ───────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Download from Firebase Console > Project Settings > Service Accounts

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Get from: https://t.me/BotFather

# ── SMS (SSL Wireless Bangladesh) ──────────────────────────
SSL_WIRELESS_API_KEY=your_sms_api_key
SSL_WIRELESS_API_SECRET=your_sms_api_secret
SSL_WIRELESS_SID=your_sender_id

# ── bKash Billing ───────────────────────────────────────────
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_SANDBOX=true                   # Set to false for production

# ── Application ─────────────────────────────────────────────
SECRET_KEY=your_secret_key_for_jwt_signing
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Google Cloud (for deployment) ──────────────────────────
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_REGION=asia-south1
