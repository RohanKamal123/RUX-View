<resources>
    <string name="app_name">VisionOS</string>
    <!-- Deliberately NOT named default_web_client_id: that name is
         auto-generated by the google-services Gradle plugin FROM
         google-services.json's oauth_client entries, but only when that
         array is non-empty (Google Sign-In enabled in Firebase Auth). Using
         the plugin's name here would compile today (empty oauth_client ->
         plugin emits nothing) but hard-fail with a duplicate-resource error
         the moment Google Sign-In is enabled and the plugin starts emitting
         it too. Own name -> builds correctly in both states; swap this
         value for the real one from oauth_client[0].client_id once Google
         Sign-In is enabled (see android/SETUP.md). -->
    <string name="google_sign_in_web_client_id"></string>
</resources>
