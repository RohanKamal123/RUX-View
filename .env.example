# ──────────────────────────────────────────────────────────────
# Vision OS — Environment Configuration
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL + pgvector) ────────────────────
# Get this from your Neon/Supabase dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/visionos

# ── AI APIs ─────────────────────────────────────────────────
# NOTE: Vertex AI is now used instead of google-generativeai.
# Authentication uses Application Default Credentials (ADC) — no API key needed.
# The GEMINI_API_KEY below is kept for backward compatibility but is NOT used.
# GEMINI_API_KEY=your_gemini_api_key_here
#GROQ_API_KEY=your_groq_api_key_here

# ── Firebase Auth ────────────────────────────────────────────
# Production: paste the entire service account JSON as a single line
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
# Development: path to downloaded service-account.json file
FIREBASE_CREDENTIALS_PATH=./service-account.json

# ── Telegram Notifications ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── SMS (SSL Wireless Bangladesh) ────────────────────────────
SSL_WIRELESS_API_KEY=your_ssl_api_key
SSL_WIRELESS_API_SECRET=your_ssl_api_secret
SSL_WIRELESS_SID=your_ssl_sid

# ── bKash Billing ────────────────────────────────────────────
BKASH_APP_KEY=01751549994
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_SANDBOX=True
BKASH_NUMBER=your_bkash_number

# ── Application ──────────────────────────────────────────────
# environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your_random_secret_key_here

# ── Upstash Redis ────────────────────────────────────────────
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ── Google Cloud (for Cloud Run deployment) ──────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=asia-south1

# ── RTMP ingest (connection_type="rtmp_push" cameras) ────────
# MediaMTX host -- see backend/core/ingest/rtmp_ingest.py and
# infrastructure/mediamtx-startup.sh. Defaults to a local dev instance;
# production (infrastructure/cloud_run_config.yaml) points these at the
# real always-on VM.
RTMP_INGEST_PUSH_HOST=localhost:1935
RTMP_INGEST_RTSP_BASE=rtsp://localhost:8554
